{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (Release x64)",
      "type": "shell",
      "command": "& (& \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -products * -version '[17.0,18.0)' -find MSBuild\\**\\Bin\\MSBuild.exe) foo_alphabar.sln -p:Configuration=Release -p:Platform=x64 -m",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (Release Win32)",
      "type": "shell",
      "command": "& (& \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -products * -version '[17.0,18.0)' -find MSBuild\\**\\Bin\\MSBuild.exe) foo_alphabar.sln -p:Configuration=Release -p:Platform=Win32 -m",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (Debug x64)",
      "type": "shell",
      "command": "& (& \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -products * -version '[17.0,18.0)' -find MSBuild\\**\\Bin\\MSBuild.exe) foo_alphabar.sln -p:Configuration=Debug -p:Platform=x64 -m",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (Debug Win32)",
      "type": "shell",
      "command": "& (& \"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -products * -version '[17.0,18.0)' -find MSBuild\\**\\Bin\\MSBuild.exe) foo_alphabar.sln -p:Configuration=Debug -p:Platform=Win32 -m",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
